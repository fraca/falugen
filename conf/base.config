// Default resources by label (nf-core template defaults) plus per-process overrides.
// Site limits (partitions, max memory/cpus/time) come from the institutional profile, e.g. pdc_kth.
process {
    cpus   = { 1 * task.attempt }
    memory = { 6.GB * task.attempt }
    time   = { 4.h * task.attempt }

    errorStrategy = { task.exitStatus in ((130..145) + 104 + 175) ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    withLabel:process_single { cpus = { 1 };                memory = { 6.GB * task.attempt };  time = { 4.h * task.attempt } }
    withLabel:process_low    { cpus = { 2 * task.attempt }; memory = { 12.GB * task.attempt }; time = { 4.h * task.attempt } }
    withLabel:process_medium { cpus = { 6 * task.attempt }; memory = { 36.GB * task.attempt }; time = { 8.h * task.attempt } }
    withLabel:process_high   { cpus = { 12 * task.attempt }; memory = { 72.GB * task.attempt }; time = { 16.h * task.attempt } }

    // Values taken from the original run_fdsm.sh job (60 GB, 16 h, 32 DIAMOND threads, 10 MEGAHIT/miniprot threads)
    withName: 'DIAMOND_BLASTX' { cpus = 32; memory = { 60.GB * task.attempt }; time = { 16.h * task.attempt } }
    withName: 'MEGAHIT'        { cpus = 10; memory = { 60.GB * task.attempt }; time = { 16.h * task.attempt } }
    withName: 'MINIPROT_ALIGN' { cpus = 10; memory = { 16.GB * task.attempt }; time = { 8.h * task.attempt } }
}
