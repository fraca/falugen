// Module arguments, output prefixes and publishing.
process {

    withName: 'FASTP' {
        ext.args   = { params.fastp_cut_tail ? '--cut_tail' : '' }
        publishDir = [ path: { "${params.outdir}/fastp" }, mode: params.publish_dir_mode, pattern: '*.{html,json,log}' ]
    }

    withName: 'DIAMOND_MAKEDB' {
        ext.prefix = 'proteins'
        publishDir = [ path: { "${params.outdir}/diamond_db" }, mode: params.publish_dir_mode, pattern: '*.dmnd' ]
    }

    withName: 'DIAMOND_BLASTX' {
        ext.args   = { "--evalue ${params.diamond_evalue} --id ${params.diamond_min_identity} --max-target-seqs ${params.diamond_max_targets} --block-size ${params.diamond_block_size}" }
        publishDir = [ path: { "${params.outdir}/diamond" }, mode: params.publish_dir_mode, pattern: '*.txt' ]
    }

    // input name is <sample>.txt: keep the output name different
    withName: 'GAWK_HIT_IDS' {
        ext.prefix = { "${meta.id}.hit_ids" }
        publishDir = [ path: { "${params.outdir}/diamond" }, mode: params.publish_dir_mode, pattern: '*.txt' ]
    }

    withName: 'SEQKIT_GREP' {
        ext.prefix = { "${meta.id}_R${meta.mate}.selected" }
        publishDir = [ path: { "${params.outdir}/selected_reads" }, mode: params.publish_dir_mode ]
    }

    withName: 'MEGAHIT' {
        // -m as an absolute number of bytes: a fraction would be applied to the whole node's RAM, not to the Slurm allocation
        ext.args   = { "--k-list ${params.megahit_k_list} --min-count ${params.megahit_min_count} --min-contig-len ${params.megahit_min_contig_len} -m ${(task.memory.toBytes() * params.megahit_memory_fraction) as long}" }
        publishDir = [ path: { "${params.outdir}/assembly" }, mode: params.publish_dir_mode, pattern: '*.contigs.fa.gz' ]
    }

    // gunzipped by the GAWK module, so the output name must differ from <sample>.contigs.fa
    withName: 'GAWK_DECOMPRESS_CONTIGS' {
        ext.prefix = { "${meta.id}.assembly" }
    }

    withName: 'MINIPROT_ALIGN' {
        ext.args   = { "--gff --trans --outs=${params.miniprot_outs}" }
        publishDir = [ path: { "${params.outdir}/miniprot" }, mode: params.publish_dir_mode, pattern: '*.gff' ]
    }

    withName: 'GAWK_STRIP_COMMENTS' {
        ext.prefix = { "${meta.id}.features" }
    }

    withName: 'GFFREAD_DNA' {
        ext.args   = '-x'
        ext.prefix = { "${meta.id}.cds_dna" }
    }

    withName: 'GFFREAD_PROTEIN' {
        ext.args   = '-y'
        ext.prefix = { "${meta.id}.cds_protein" }
    }

    // one FASTA pair per sample and distinct contig_start_end locus
    // (the GAWK module is run with output redirection disabled: the awk program writes the files itself)
    withName: 'GAWK_SPLIT_DNA' {
        ext.args   = { "-v p=${meta.id} -v kind=DNA" }
        ext.prefix = { "${meta.id}_DNA" }
        publishDir = [ path: { "${params.outdir}/sequences" }, mode: params.publish_dir_mode, pattern: '*.fasta' ]
    }

    withName: 'GAWK_SPLIT_PROTEIN' {
        ext.args   = { "-v p=${meta.id} -v kind=protein" }
        ext.prefix = { "${meta.id}_protein" }
        publishDir = [ path: { "${params.outdir}/sequences" }, mode: params.publish_dir_mode, pattern: '*.fasta' ]
    }
}
