{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/nf-gene-detect/master/nextflow_schema.json",
  "title": "falungen pipeline parameters",
  "description": "Detect a gene in paired-end short reads: DIAMOND blastx, targeted MEGAHIT assembly, miniprot, gffread.",
  "type": "object",
  "$defs": {
    "input_output_options": {
      "title": "Input/output options",
      "type": "object",
      "required": ["input", "outdir"],
      "properties": {
        "input":  { "type": "string", "format": "file-path", "pattern": "^\\S+\\.csv$", "description": "Samplesheet CSV with columns sample,lane,fastq_1,fastq_2." },
        "outdir": { "type": "string", "format": "directory-path", "default": "results", "description": "Output directory." },
        "publish_dir_mode": { "type": "string", "default": "copy", "enum": ["symlink", "rellink", "link", "copy", "copyNoFollow", "move"], "hidden": true }
      }
    },
    "reference_options": {
      "title": "Reference options",
      "type": "object",
      "required": ["diamond_db", "gene_hit"],
      "properties": {
        "diamond_db": { "type": "string", "format": "file-path", "description": "DIAMOND protein database (.dmnd) used to find candidate reads." },
        "gene_hit":   { "type": "string", "format": "file-path", "description": "Protein FASTA aligned to the assembled contigs with miniprot." }
      }
    },
    "tool_options": {
      "title": "Tool options",
      "type": "object",
      "properties": {
        "fastp_cut_tail":          { "type": "boolean", "default": true, "description": "Run fastp with --cut_tail." },
        "diamond_evalue":          { "type": "string",  "default": "1e-5", "description": "DIAMOND --evalue." },
        "diamond_min_identity":    { "type": "integer", "default": 20, "description": "DIAMOND --id (minimum % identity)." },
        "diamond_max_targets":     { "type": "integer", "default": 1, "description": "DIAMOND --max-target-seqs." },
        "diamond_block_size":      { "type": "integer", "default": 8, "description": "DIAMOND --block-size." },
        "megahit_k_list":          { "type": "string",  "default": "21,31,41,51,61,71,81,91,101,111,121,131,141", "description": "MEGAHIT --k-list." },
        "megahit_min_count":       { "type": "integer", "default": 2, "description": "MEGAHIT --min-count." },
        "megahit_min_contig_len":  { "type": "integer", "default": 100, "description": "MEGAHIT --min-contig-len." },
        "megahit_memory_fraction": { "type": "number",  "default": 0.8, "description": "Fraction of the memory allocated to the MEGAHIT task that MEGAHIT may use." },
        "miniprot_outs":           { "type": "number",  "default": 0.01, "description": "miniprot --outs." }
      }
    }
  },
  "allOf": [
    { "$ref": "#/$defs/input_output_options" },
    { "$ref": "#/$defs/reference_options" },
    { "$ref": "#/$defs/tool_options" }
  ]
}
