manifest {
    name            = 'nf-gene-detect'
    author          = 'Marco Fraca'
    description     = 'Detect genes in paired-end short reads: DIAMOND blastx, targeted MEGAHIT assembly, miniprot, gffread (nf-core modules).'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=25.04.0'
    version         = '0.1.0dev'
}

params {
    // Input / output
    input                   = null
    outdir                  = 'results'
    publish_dir_mode        = 'copy'

    // Query proteins: ONE multi-FASTA (uncompressed). It is used to build the DIAMOND database
    // and as the miniprot query.
    proteins                = null

    // Trimming
    fastp_cut_tail          = true

    // DIAMOND blastx
    diamond_evalue          = '1e-5'
    diamond_min_identity    = 20
    diamond_max_targets     = 1
    diamond_block_size      = 8

    // MEGAHIT
    megahit_k_list          = '21,31,41,51,61,71,81,91,101,111,121,131,141'
    megahit_min_count       = 2
    megahit_min_contig_len  = 100
    megahit_memory_fraction = 0.8       // fraction of the memory ALLOCATED to the task

    // miniprot
    miniprot_outs           = 0.01

    // nf-core institutional configs (provides -profile pdc_kth for Dardel)
    custom_config_version   = 'master'
    custom_config_base      = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

// nf-core institutional profiles, e.g. -profile pdc_kth --project naissXXXX-X-XXXX
includeConfig params.custom_config_base ? "${params.custom_config_base}/nfcore_custom.config" : '/dev/null'

profiles {
    debug      { process.beforeScript = 'echo $HOSTNAME' }
    conda      { conda.enabled = true; conda.channels = ['conda-forge', 'bioconda'] }
    docker     { docker.enabled = true; docker.runOptions = '-u $(id -u):$(id -g)' }
    singularity { singularity.enabled = true; singularity.autoMounts = true }
    apptainer  { apptainer.enabled = true; apptainer.autoMounts = true }
}

process.shell = ['/bin/bash', '-euo', 'pipefail']
